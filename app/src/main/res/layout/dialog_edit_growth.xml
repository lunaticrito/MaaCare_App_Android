<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/poppins"
        android:text="Add / Edit Growth Measurement"
        android:textColor="@color/primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/poppins"
        android:text="Select baby's age (Birth = 0m, or 1m–12m) to record or update weight &amp; height."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/poppins"
        android:text="Measurement Age"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_growth_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_0"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Birth (0m)" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_1"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_2"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_3"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_4"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_5"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_6"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_9"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9m" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month_12"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12m" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:hint="Weight (kg)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_growth_weight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:hint="Height (cm)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_growth_height"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:inputType="numberDecimal"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_growth_existing_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins"
        android:text="Editing existing entry"
        android:textColor="@color/secondary"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
