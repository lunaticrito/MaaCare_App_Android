<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_dialog_timeline_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="@font/poppins"
        android:text="Edit Care Activity"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/poppins"
        android:text="Category"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_timeline_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_feeding"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FEEDING" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_diaper"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIAPER" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_sleep"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SLEEP" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_cat_bath"
                style="@style/Widget.MaaCare.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATH" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="Activity Title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_timeline_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:inputType="textCapSentences"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="Notes / Details">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_timeline_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_timeline_time_selected"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins"
            android:text="Time: 09:00 AM"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_timeline_time"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="Pick Time"
            android:textColor="@color/primary"
            app:strokeColor="@color/chip_unselected_border" />
    </LinearLayout>

</LinearLayout>
