<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="100dp">

        <!-- Top Rapid Response SOS Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/emergency_red_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/emergency_red"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_emergency_sos"
                    app:tint="@color/emergency_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins"
                    android:text="@string/emergency_title"
                    android:textColor="@color/emergency_red_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_emergency_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:text="@string/emergency_info_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- 1-Tap SOS Call 999 Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_call_ambulance"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/emergency_red"
                    android:fontFamily="@font/poppins"
                    android:text="@string/sos_call_ambulance"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_call"
                    app:iconTint="@color/white" />

                <!-- 1-Tap SOS Call Caregiver Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_call_caregiver"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins"
                    android:text="@string/sos_call_caregiver"
                    android:textColor="@color/emergency_red_dark"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_call"
                    app:iconTint="@color/emergency_red"
                    app:strokeColor="@color/emergency_red" />

                <!-- Import Caregiver from Contacts Button (ContactsContract) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_import_contact_caregiver"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins"
                    android:text="@string/btn_import_caregiver"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_call"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary" />

                <!-- Active Caregiver Contact Display -->
                <TextView
                    android:id="@+id/tv_caregiver_contact_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/poppins"
                    android:text="Caregiver: +8801711223344"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 1-Tap SOS SMS Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_send_sms"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins"
                    android:text="@string/sos_send_sms"
                    android:textColor="@color/emergency_red_dark"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_sms"
                    app:iconTint="@color/emergency_red_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Doctor Directory Section ("Find A Doctor Near You") -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins"
            android:text="@string/doctor_dir_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Stats Row (129 Doctors | 8 Divisions | 64 Districts) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_bottom_sheet_dialog"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/stat_verified_doctors_129"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_bottom_sheet_dialog"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/stat_divisions_8"
                android:textColor="@color/teal_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_bottom_sheet_dialog"
                android:fontFamily="@font/poppins"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/stat_districts"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Doctor Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/primary"
            app:startIconDrawable="@drawable/ic_hospital"
            app:startIconTint="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_doctors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:hint="@string/search_doctor_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 8 Divisions Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_doctor_division"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@+id/chip_div_all"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_all"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="@font/poppins"
                    android:text="@string/filter_all_divisions" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_dhaka"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/div_dhaka" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_chattogram"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/div_chattogram" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_khulna"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/div_khulna" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_rajshahi"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/div_rajshahi" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_sylhet"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/div_sylhet" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_barishal"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/div_barishal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_rangpur"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/div_rangpur" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_div_mymensingh"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/div_mymensingh" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Dynamic 64-District Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_doctor_district"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- Specialty Filter Chips (All, Obs & Gynae, Pediatrics) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_doctor_specialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@+id/chip_spec_all"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_spec_all"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="@font/poppins"
                    android:text="@string/filter_all_specialists" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_spec_obs_gynae"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/spec_obs_gynae" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_spec_pediatrician"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/spec_pediatrics" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tv_doctor_result_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins"
            android:text="Showing 129 specialists across 64 districts"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Nearest Doctors List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_nearest_doctors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false" />

        <!-- Hospital Bag Essentials Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins"
            android:text="@string/tab_essentials"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Hospital Essentials Checklist RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_hospital_essentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false" />

        <!-- Obstetric Danger Signs Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins"
            android:text="@string/danger_signs_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Danger Signs RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_danger_signs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
