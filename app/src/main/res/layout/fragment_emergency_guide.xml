<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Rapid Response SOS Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/emergency_red_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="@color/emergency_red"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_emergency_sos"
                    app:tint="@color/emergency_red" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/emergency_title"
                    android:textColor="@color/emergency_red_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_emergency_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="One-tap calling &amp; automated emergency SMS with maternal vitals."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- 1-Tap SOS Call 999 Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_call_ambulance"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/emergency_red"
                    android:fontFamily="@font/inter"
                    android:text="@string/sos_call_ambulance"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_call"
                    app:iconTint="@color/white" />

                <!-- 1-Tap SOS Call Caregiver Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_call_caregiver"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/sos_call_caregiver"
                    android:textColor="@color/emergency_red_dark"
                    android:textSize="13sp"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_call"
                    app:iconTint="@color/emergency_red"
                    app:strokeColor="@color/emergency_red" />

                <!-- 1-Tap SOS SMS Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sos_send_sms"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:text="@string/sos_send_sms"
                    android:textColor="@color/emergency_red_dark"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_sms"
                    app:iconTint="@color/emergency_red_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Doctor Directory Section ("Find A Doctor Near You") -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="@string/doctor_dir_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Stats Row (100+ Doctors | 64 Districts | 200+ Hospitals) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_bottom_sheet_dialog"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/stat_verified_doctors"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_bottom_sheet_dialog"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/stat_districts"
                android:textColor="@color/teal_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_bottom_sheet_dialog"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/stat_hospitals"
                android:textColor="@color/accent_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search Doctor Input -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/primary"
            app:startIconDrawable="@drawable/ic_hospital"
            app:startIconTint="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_search_doctors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:hint="@string/search_doctor_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Specialty Filter Chips (All, Obstetrician, Gynecologist, Pediatrician) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_doctor_specialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@+id/chip_spec_all"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_spec_all"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="@font/inter"
                    android:text="All Specialists" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_spec_obstetrician"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/spec_obstetrician" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_spec_gynecologist"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/spec_gynecologist" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_spec_pediatrician"
                    style="@style/Widget.MaaCare.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/spec_pediatrician" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Nearest Doctors List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_nearest_doctors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false" />

        <!-- Hospital Bag Essentials Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter"
            android:text="@string/tab_essentials"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Hospital Essentials Checklist RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_hospital_essentials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:nestedScrollingEnabled="false" />

        <!-- Obstetric Danger Signs Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter"
            android:text="@string/danger_signs_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Danger Signs RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_danger_signs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
