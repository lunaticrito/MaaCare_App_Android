<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="100dp">

        <!-- Top Header & Profile Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_mother_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello, Anna"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_profile_subtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Week 30, Day 4 • Blood: O+ • 74 Days to EDD"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_profile"
                    style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_btn"
                    android:textColor="@color/primary"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ultrasound & Baby Memory Photo Card (Showcasing RelativeLayout architecture) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/chip_unselected_border"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_photo_memory_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:fontFamily="@font/poppins"
                    android:text="@string/photo_memory_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_photo_memory_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_photo_memory_title"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins"
                    android:text="@string/photo_memory_sub"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_ultrasound_photo"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_below="@id/tv_photo_memory_sub"
                    android:layout_marginTop="10dp"
                    android:background="#F1F5F9"
                    android:contentDescription="Ultrasound and Baby Milestone Photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_pregnancy_tracker"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent" />

                <TextView
                    android:id="@+id/tv_photo_file_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/iv_ultrasound_photo"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/poppins"
                    android:text="@string/photo_memory_ready"
                    android:textColor="@color/secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_ultrasound_photo"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/iv_ultrasound_photo"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="@color/primary_button_bg"
                    android:fontFamily="@font/poppins"
                    android:text="@string/btn_pick_photo"
                    android:textColor="@color/primary_button_text"
                    android:textSize="12sp"
                    app:cornerRadius="10dp" />

            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Custom View: Pregnancy Arc Progress Gauge -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pregnancy_progress_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Custom View extending android.view.View -->
                <com.cse2200.maacare.ui.custom.PregnancyProgressArcView
                    android:id="@+id/arc_pregnancy_progress"
                    android:layout_width="260dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"
                    app:arcStrokeWidth="18dp"
                    app:currentWeek="30"
                    app:indicatorColor="@color/primary"
                    app:maxWeeks="40"
                    app:showCenterText="true"
                    app:trackColor="#E0E0E0"
                    app:trimester1Color="@color/trimester1_color"
                    app:trimester2Color="@color/trimester2_color"
                    app:trimester3Color="@color/trimester3_color" />

                <!-- Trimester Legend Pills -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/trimester1_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/trimester_1_legend"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/trimester2_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="12dp"
                        android:text="@string/trimester_2_legend"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@color/trimester3_color" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/trimester_3_legend"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_countdown_edd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="74 Days to Estimated Delivery"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fully Editable Maternal Hydration & Foreground Service Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/secondary_light"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_water_drop"
                        app:tint="@color/secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hydration_controller_title"
                            android:textColor="@color/secondary_dark"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_water_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1750 mL / 3000 mL (58%)"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_edit_hydration"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_edit_hydration"
                        android:textColor="@color/secondary_dark" />
                </LinearLayout>

                <!-- Horizontal Intake Progress Bar -->
                <ProgressBar
                    android:id="@+id/pb_water_progress"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="58"
                    android:progressTint="@color/secondary" />

                <!-- Quick Adjust Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_250"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/secondary"
                        android:text="@string/btn_add_250"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_500"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/secondary"
                        android:text="@string/btn_add_500"
                        android:textSize="11sp"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sub_250"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/btn_sub_250"
                        android:textColor="@color/secondary_dark"
                        android:textSize="11sp"
                        app:cornerRadius="8dp"
                        app:strokeColor="@color/secondary" />
                </LinearLayout>

                <!-- Service Controller Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_toggle_service"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Start Foreground Monitor Service"
                    android:textColor="@color/secondary_dark"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Weekly Fetal Growth Milestones Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/fetal_milestones_heading"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- RecyclerView for Fetal Milestones -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_fetal_milestones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
